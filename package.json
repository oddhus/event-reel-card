{
  "name": "event-reel-card",
  "version": "0.6.0",
  "private": true,
  "description": "Home Assistant Lovelace card: a compact timeline of the day's events with animated Frigate previews and exact clips.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.dev.config.ts",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint . --deny-warnings --report-unused-disable-directives-severity=error && tsc --noEmit",
    "format": "prettier --write .",
    "lint:fix": "oxlint --fix ."
  },
  "dependencies": {
    "hls.js": "^1.7.3",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "@types/node": "^26.6.3",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
