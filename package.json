{
  "name": "event-reel-card",
  "version": "0.7.0",
  "private": true,
  "description": "Home Assistant Lovelace card: a compact timeline of the day's events with animated Frigate previews and exact clips.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.dev.config.ts",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint . --deny-warnings --report-unused-disable-directives-severity=error && tsc --noEmit",
    "format": "prettier --write .",
    "lint:fix": "oxlint --fix .",
    "test:ui": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "hls.js": "^1.7.3",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "^5.1.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.0.2"
  }
}
